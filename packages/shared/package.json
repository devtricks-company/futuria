{
  "name": "@futuria/shared",
  "version": "0.1.0",
  "private": true,
  "description": "FUTURIA shared Zod schemas, types, plan limits and fixtures.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@futuria/config": "workspace:*",
    "@types/node": "^24",
    "eslint": "10.15.0",
    "tsup": "9.0.0",
    "typescript": "~6.0.3",
    "vitest": "5.1.0"
  }
}
