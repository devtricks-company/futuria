{
  "name": "@futuria/engine",
  "version": "0.1.0",
  "private": true,
  "description": "FUTURIA deterministic Monte Carlo simulation engine (runs in the browser and on the server).",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "tsx src/demo.ts"
  },
  "dependencies": {
    "@futuria/shared": "workspace:*"
  },
  "devDependencies": {
    "@futuria/config": "workspace:*",
    "@types/node": "^24",
    "eslint": "10.15.0",
    "fast-check": "4.10.2",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "~6.0.3",
    "vitest": "5.1.0"
  }
}
