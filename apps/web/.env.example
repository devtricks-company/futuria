# Copy to .env.local and adjust. Never commit .env.local.

# Base URL of the FUTURIA API (NestJS). Server-side only: the browser reaches the API through the
# same-origin proxy at /api/backend.
API_URL=http://localhost:4000

# Clerk (optional until Phase 5). Without a publishable key the app runs without sign-in and the
# proxy uses the API's dev identity (the API must then run in AUTH_MODE=dev).
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
