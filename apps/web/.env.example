# Copy to .env.local and adjust. Never commit .env.local.

# Base URL of the FUTURIA API (NestJS). Server-side only: the browser reaches the API through the
# same-origin proxy at /api/backend.
API_URL=http://localhost:4000

# Clerk (optional). Without a publishable key the app runs without sign-in and the proxy uses
# the API's dev identity (the API must then run in AUTH_MODE=dev). With keys, the API needs
# CLERK_SECRET_KEY too. Signed-out visitors can draft a simulation (an anonymous cookie); the
# signup gate comes before the run, and /dashboard and /settings require sign-in.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# Use the app's own pages for sign-in and sign-up (also where /dashboard redirects signed-out
# visitors):
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Force Clerk off even with keys above (what `pnpm --filter @futuria/web build:e2e` does):
# NEXT_PUBLIC_CLERK_DISABLED=1

# Public origin of the site, for absolute URLs in link previews (og:image), canonical links and the
# sitemap. Read at build time. Defaults to http://localhost:3000. To test link previews locally,
# set it to your tunnel URL (e.g. https://abc.trycloudflare.com) and rebuild.
# NEXT_PUBLIC_SITE_URL=https://futuria.app

# Product analytics (PostHog, optional). Without a key nothing is loaded or sent. Events go
# through the app's own /ingest relay. Region: us (default) or eu, matching your PostHog project.
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
# NEXT_PUBLIC_POSTHOG_REGION=us
