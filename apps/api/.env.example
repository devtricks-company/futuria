# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins (CORS + Clerk authorized parties).
WEB_ORIGIN=http://localhost:3000

# MongoDB Atlas: in Atlas, Connect > Drivers, copy the connection string and fill in the password
# (percent-encode special characters such as @ : / ? #). Your IP must be on the Atlas
# Network Access list. If the string has no database name, the API uses "futuria".
# Then create the collections and indexes with:
#   pnpm --filter @futuria/api db:setup --seed
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/futuria?retryWrites=true&w=majority
# Local MongoDB instead (Windows service, or `docker compose up -d`):
# MONGODB_URI=mongodb://127.0.0.1:27017/futuria

# Server for the e2e tests' throwaway futuria_test_* databases. Unset means local MongoDB.
# To run them on Atlas, use the same string without a database name.
# MONGODB_TEST_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Auth: "dev" trusts an x-dev-user header (local only, refused in production).
# Set CLERK_SECRET_KEY (and remove AUTH_MODE or set it to clerk) to use real Clerk sign-in.
AUTH_MODE=dev
# CLERK_SECRET_KEY=
# CLERK_JWT_KEY=

# Claude (Phase 3). With no credential the API uses AI_MODE=fixture: recorded or synthetic
# output, no API calls, no cost. Setting a key switches to AI_MODE=anthropic.
# ANTHROPIC_API_KEY=
# Some gateways expect "Authorization: Bearer" instead of x-api-key; use this instead of the key:
# ANTHROPIC_AUTH_TOKEN=
# Gateway or proxy root, without /v1 (the SDK appends /v1/messages). Unset = api.anthropic.com.
# ANTHROPIC_BASE_URL=https://your-gateway.example.com
# AI_MODE=fixture
# AI_MODEL=claude-opus-5-5
# Turn these off only if your gateway rejects them (pnpm --filter @futuria/api ai:probe tells you):
# AI_REFUSAL_FALLBACK=true
# AI_PROMPT_CACHE=true

# Run pipeline (Phase 3). Unset = inline (steps run inside the API process, fine for local work).
# For the Inngest Dev Server: run `npx inngest-cli@latest dev -u http://localhost:4000/api/inngest`
# and set INNGEST_DEV=1. Production uses Inngest Cloud keys.
# INNGEST_DEV=1
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=
# PIPELINE_MODE=inline
# Phase 5+
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
