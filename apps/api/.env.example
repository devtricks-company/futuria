# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins (CORS + Clerk authorized parties).
WEB_ORIGIN=http://localhost:3000

# Local MongoDB (Windows service, or `docker compose up -d`). Create it with:
#   pnpm --filter @futuria/api db:setup
MONGODB_URI=mongodb://127.0.0.1:27017/futuria

# Auth: "dev" trusts an x-dev-user header (local only, refused in production).
# Set CLERK_SECRET_KEY (and remove AUTH_MODE or set it to clerk) to use real Clerk sign-in.
AUTH_MODE=dev
# CLERK_SECRET_KEY=
# CLERK_JWT_KEY=

# Phase 3+
# ANTHROPIC_API_KEY=
# AI_MODE=fixture
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=
# Phase 5+
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
