{
  "name": "@futuria/api",
  "version": "0.1.0",
  "private": true,
  "description": "FUTURIA API (NestJS).",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests && vitest run --config ./vitest.config.e2e.ts",
    "test:unit": "vitest run",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@futuria/engine": "workspace:*",
    "@futuria/shared": "workspace:*",
    "@nestjs/common": "12.4.2",
    "@nestjs/core": "12.4.2",
    "@nestjs/platform-express": "12.4.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@futuria/config": "workspace:*",
    "@nestjs/cli": "12.0.13",
    "@nestjs/schematics": "12.0.13",
    "@nestjs/testing": "12.4.2",
    "@types/express": "^5.0.0",
    "@types/node": "^24",
    "@types/supertest": "7.2.1",
    "eslint": "10.15.0",
    "supertest": "7.3.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.0",
    "vitest": "5.1.0"
  }
}
